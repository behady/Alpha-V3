<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed on Android 8/9 to drop saved reports into the Downloads
         folder. Android 10+ uses MediaStore and needs no permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Deliberately NOT requesting CAMERA: taking a photo for a patient upload
         is handed to the phone's own camera app, which needs no permission
         from us. Fewer permissions = fewer questions from clinic staff. -->

    <!-- Lets THIS phone send the clinic's appointment reminders from its own SIM,
         for clinics that cannot get a WhatsApp Business account or a messaging
         gateway. Only ever requested when an Admin pairs this handset from
         Settings → SMS; the app never asks for it on first launch, and never
         reads, receives or stores any message.

         Note this permission puts the app outside Google Play's SMS policy, which
         only permits it for a phone's default messaging app. That is not a problem
         here because Alpha Dental is installed by sideloading the APK, not through
         the Play Store — but it does mean this app cannot be published there while
         this permission is declared. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- The reminder poller is rescheduled after a restart, so a clinic phone that
         reboots overnight is still sending at 07:00 without anyone touching it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Only present so a phone without a SIM (a tablet on wifi) can still install
         and be used as an ordinary client. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".AlphaApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlphaDental"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode|navigation|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AlphaDental.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
