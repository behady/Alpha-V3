<?xml version="1.0" encoding="utf-8"?>
<!-- Patient data only ever travels over HTTPS. Plain HTTP is refused outright,
     so a hijacked Wi-Fi network cannot downgrade the connection. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
