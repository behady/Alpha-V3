rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userData.get('isSuperAdmin', false) == true || userData.get('isSuperAdmin', 'false') == 'true');
    }

    function getClinicRole(clinicId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clinicRoles', {}).get(clinicId, null);
    }

    function hasClinicRole(clinicId) {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clinicRoles', {}).keys().hasAny([clinicId]);
    }

    function isClinicAdmin(clinicId) {
      return hasClinicRole(clinicId) && getClinicRole(clinicId) == 'Admin';
    }

    function isClinicActive(clinicId) {
      let clinic = get(/databases/$(database)/documents/clinics/$(clinicId)).data;
      // Also allow creation / free trial when expiresAt is not strictly enforced yet, 
      // but generally ensure it's active.
      return clinic.get('status', 'Active') == 'Active';
    }

    // =====================================================================
    // --- GLOBAL COLLECTIONS ---
    // =====================================================================

    match /users/{userId} {
      allow read: if isAuth(); // Users need to read other users to display names, or at least their own

      // First-login self-provisioning (see AuthContext). Never allowed to self-grant
      // isSuperAdmin or pre-seed clinicRoles at creation time.
      allow create: if isAuth() && request.auth.uid == userId
        && request.resource.data.get('isSuperAdmin', false) == false
        && request.resource.data.get('clinicRoles', {}) == {};

      // Users can update their own profile fields, but can NEVER touch isSuperAdmin or
      // clinicRoles on themselves — those are platform/clinic-admin-controlled only
      // (clinicRoles is granted server-side via Admin SDK: staff invite / self-signup routes).
      // Super admins may update any user doc (e.g. toggling isSuperAdmin on someone else).
      allow update: if isSuperAdmin()
        || (isAuth() && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperAdmin', 'clinicRoles']));

      allow delete: if isSuperAdmin();
    }

    match /join_requests/{requestId} {
      allow read: if isAuth();
      // Can only file a join request as yourself, not on behalf of another userId.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Only Clinic Admins of the requested clinic (or Super Admins) can approve/reject,
      // and approving may only ever change the `status` field.
      allow update: if isSuperAdmin()
        || (isAuth() && isClinicAdmin(resource.data.clinicId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isSuperAdmin() || (isAuth() && isClinicAdmin(resource.data.clinicId));
    }

    // =====================================================================
    // --- CLINICS MULTI-TENANCY ---
    // =====================================================================

    match /clinics/{clinicId} {
      allow read: if isSuperAdmin() || hasClinicRole(clinicId);
      // Free-trial self-signup is created server-side via Admin SDK (see
      // /api/onboarding/create-clinic), which bypasses these rules entirely — so client-side
      // create/update of the clinic doc itself (tier, status, pricing, feature flags) is
      // superadmin-only. Legitimate clinic self-service profile edits (name/phone/logo) live
      // in the separate clinics/{clinicId}/settings/clinicProfile document below, unaffected.
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // --- ALL CLINIC SUBCOLLECTIONS ---
      // We allow read/write to any subcollection if the user has ANY role in this clinic.
      // We also enforce that the clinic is active for WRITE operations (except Super Admins).
      // NOTE: the path here is /{subcollection}/{document=**}, NOT /{document=**} directly under
      // clinics/{clinicId} — a recursive wildcard placed directly under the parent also matches the
      // parent document itself (zero extra segments), which would silently re-grant write access to
      // the clinic doc above (rules are OR'd across all matching blocks) and undo the superadmin-only
      // restriction on `clinics/{clinicId}` itself. Requiring an explicit {subcollection} segment
      // first means this can only ever match clinics/{clinicId}/<something>/..., never the parent.
      match /{subcollection}/{document=**} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if isSuperAdmin() || (hasClinicRole(clinicId) && isClinicActive(clinicId));
      }

      // --- SPECIFIC SUBCOLLECTION OVERRIDES ---
      // If you need more granular permissions (e.g. only Admins can delete staff)
      match /staff/{staffId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if isSuperAdmin() || (isClinicAdmin(clinicId) && isClinicActive(clinicId));
      }
      
      match /settings/{docId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if isSuperAdmin() || (isClinicAdmin(clinicId) && isClinicActive(clinicId));
      }
    }
    
    // --- LEGACY SETTINGS OVERRIDE ---
    match /settings/wapilot {
      allow read, write: if false; // Only Admin SDK
    }
  }
}
