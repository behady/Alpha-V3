rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userData.get('isSuperAdmin', false) == true || userData.get('isSuperAdmin', 'false') == 'true');
    }

    function getClinicRole(clinicId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clinicRoles', {}).get(clinicId, null);
    }

    function hasClinicRole(clinicId) {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clinicRoles', {}).keys().hasAny([clinicId]);
    }

    function isClinicAdmin(clinicId) {
      return hasClinicRole(clinicId) && getClinicRole(clinicId) == 'Admin';
    }

    function isClinicActive(clinicId) {
      let clinic = get(/databases/$(database)/documents/clinics/$(clinicId)).data;
      let expires = clinic.get('expiresAt', null);
      // An expired trial is not an active clinic. This only checked `status` before, so a free
      // trial ran forever: nothing ever flipped status, and expiresAt was the field that was
      // supposed to end it. Guarded with a type check rather than compared blind — a document
      // holding expiresAt as a string would otherwise throw here and deny every write in the
      // clinic, which is a far worse failure than a trial that overstays.
      return clinic.get('status', 'Active') == 'Active'
        && (!(expires is timestamp) || expires > request.time);
    }

    // ---------------------------------------------------------------------
    // --- GRANULAR PERMISSIONS ---
    //
    // The per-clinic permission list, written server-side into the same user document these
    // rules already read for roles. Before this, the permission checkboxes on the Users screen
    // were decoration: `Protect` and `PermissionGuard` hid buttons in the browser, while the
    // blanket clinic-member grant below let any member write any collection. Someone with
    // "Delete patients" switched off could still delete patients from the console, from a
    // copied fetch call, or by asking the AI assistant to do it.
    //
    // The stored list is already expanded — role baseline plus whatever the admin ticked — so
    // there is no role policy in this file to drift out of step. See src/lib/permissions.ts;
    // the collection→permission maps below are the one part that IS duplicated there.
    // ---------------------------------------------------------------------

    function clinicPermissions(clinicId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
               .get('clinicPermissions', {}).get(clinicId, null);
    }

    /**
     * A null permission means the collection is open to any member (shared working data).
     *
     * There used to be a third branch here: a null LIST also passed, on the theory that an account
     * predating per-clinic permissions should not be locked out mid-shift. Nothing ever wrote
     * `clinicPermissions`, so that branch was the only one anyone took — every permission check in
     * this file passed, for everybody, always. The checkboxes on the Users screen hid buttons in
     * the browser and nothing more, which is the exact bug this layer was written to fix.
     *
     * The field is now written by src/lib/server/clinicPermissions.ts on every route that seeds or
     * edits permissions, and scripts/backfill-clinic-permissions.mjs filled it in for accounts that
     * predate it. So a missing list is no longer "not migrated yet" — it is an account nobody has
     * granted anything, and the safe reading of that is nothing.
     *
     * `tests/permissions.test.mts` fails if a field this file reads is one no server route writes,
     * which is what would have caught the original bug.
     *
     * An empty list denies too, and deliberately: an admin who unticks every box means it.
     * Admins never consult a list — isClinicAdmin short-circuits above — so this cannot lock an
     * owner out of their own clinic.
     *
     * The null check is written out rather than left to `null.hasAny()` raising and being counted
     * as a deny. Both end in a refusal, but only one of them says so on purpose, and an error is a
     * poor thing to build a security boundary on: it reads as an oversight to the next person, and
     * it denies for a reason that never appears in the rule.
     */
    function holdsPermission(clinicId, permission) {
      return permission == null
        || isClinicAdmin(clinicId)
        || (clinicPermissions(clinicId) != null
            && clinicPermissions(clinicId).hasAny([permission]));
    }

    // Kept as maps rather than ternary chains so this reads as the table it is, and so a
    // collection that is missing is plainly missing. Mirrors COLLECTION_WRITE_PERMISSIONS.
    function permCreate(sub) {
      return {
        'patients': 'patients.add',
        'patient_media': 'patients.edit',
        'appointments': 'appointments.add',
        'ledger': 'finance.add',
        'inventory': 'inventory.add',
        'inventory_transactions': 'inventory.edit',
        'clinical_notes': 'clinical.edit',
        'treatment_plans': 'clinical.edit',
        'prescriptions': 'clinical.edit',
        'diagnosis_chats': 'clinical.edit',
        'ortho_cases': 'clinical.edit',
        'ortho_sessions': 'clinical.edit',
        'services': 'access.settings',
        'categories': 'access.settings',
        'drugs': 'access.settings',
        'marketing_campaigns': 'access.marketing',
        'marketing_cases': 'access.marketing',
        'marketing_consents': 'access.marketing',
        'marketing_content': 'access.marketing',
        'marketing_settings': 'access.marketing'
      }.get(sub, null);
    }

    function permUpdate(sub) {
      return {
        'patients': 'patients.edit',
        'patient_media': 'patients.edit',
        'appointments': 'appointments.edit',
        'ledger': 'finance.edit',
        'inventory': 'inventory.edit',
        'inventory_transactions': 'inventory.edit',
        'clinical_notes': 'clinical.edit',
        'treatment_plans': 'clinical.edit',
        'prescriptions': 'clinical.edit',
        'diagnosis_chats': 'clinical.edit',
        'ortho_cases': 'clinical.edit',
        'ortho_sessions': 'clinical.edit',
        'services': 'access.settings',
        'categories': 'access.settings',
        'drugs': 'access.settings',
        'marketing_campaigns': 'access.marketing',
        'marketing_cases': 'access.marketing',
        'marketing_consents': 'access.marketing',
        'marketing_content': 'access.marketing',
        'marketing_settings': 'access.marketing'
      }.get(sub, null);
    }

    function permDelete(sub) {
      return {
        'patients': 'patients.delete',
        'patient_media': 'patients.edit',
        'appointments': 'appointments.delete',
        'ledger': 'finance.delete',
        'inventory': 'inventory.delete',
        'inventory_transactions': 'inventory.delete',
        'clinical_notes': 'clinical.delete',
        'treatment_plans': 'clinical.delete',
        'prescriptions': 'clinical.delete',
        'diagnosis_chats': 'clinical.delete',
        'ortho_cases': 'clinical.delete',
        'ortho_sessions': 'clinical.delete',
        'services': 'access.settings',
        'categories': 'access.settings',
        'drugs': 'access.settings',
        'marketing_campaigns': 'access.marketing',
        'marketing_cases': 'access.marketing',
        'marketing_consents': 'access.marketing',
        'marketing_content': 'access.marketing',
        'marketing_settings': 'access.marketing'
      }.get(sub, null);
    }

    /**
     * The baseline "is this person allowed to write in this clinic at all" test.
     *
     * system_logs, staff, settings and the server-only subcollections are carved out here because
     * Firestore rules OR together: a narrower `allow write` in a more specific match block below
     * can only ever ADD permissions, never take away what the blanket grant already handed out.
     * Without these exclusions, the "Admin only" restrictions on staff/settings and the
     * "superadmin only" restriction on system_logs would all be silently overridden by "any clinic
     * member can write". staff/settings had exactly this bug live in production — the override
     * blocks looked like they restricted access and never actually did anything.
     */
    function memberMayWrite(clinicId, sub) {
      return hasClinicRole(clinicId) && isClinicActive(clinicId)
        && sub != 'system_logs' && sub != 'staff' && sub != 'settings'
        && sub != 'ai_deletion_log' && sub != 'ai_pending_actions'
        && sub != 'message_drafts' && sub != 'sms_outbox'
        && sub != 'sms_devices' && sub != 'leads'
        && sub != 'ai_usage' && sub != 'ai_usage_log'
        && sub != 'whatsapp_outbox'
        && sub != 'ledger' && sub != 'ledger_audit'
        && sub != 'clinical_notes' && sub != 'services'
        // Everything the recycle bin covers. A client delete on these would destroy the record
        // with no snapshot, and the bin would then be advisory rather than true — the worst
        // outcome being a dentist who deletes from a stale browser tab, finds Recently Deleted
        // empty, and concludes the feature is broken. Creates and updates stay with the client;
        // only the delete moves. See src/lib/recycleBin.ts.
        && sub != 'patients' && sub != 'patient_media'
        && sub != 'prescriptions' && sub != 'treatment_plans'
        && sub != 'diagnosis_chats' && sub != 'inventory'
        && sub != 'drugs' && sub != 'marketing_content'
        && sub != 'attendance';
    }

    // Two accounts that work at the same clinic. Used to scope who may read whose profile.
    function sharesAClinicWithCaller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
               .get('clinicRoles', {}).keys()
               .hasAny(resource.data.get('clinicRoles', {}).keys());
    }

    // =====================================================================
    // --- GLOBAL COLLECTIONS ---
    // =====================================================================

    match /users/{userId} {
      /**
       * A user document holds an email, a real name, and the ID of every clinic that person
       * works at. `if isAuth()` published all of it to anyone holding an account — and anyone
       * can create an account, in about thirty seconds, from the sign-up form. That was a
       * readable directory of every clinic and every member of staff on the platform, and it
       * also handed out the exact uid list the admin API routes take as input.
       *
       * Three legitimate readers remain: yourself, a colleague at a clinic you both work at
       * (the app shows staff names all over the place), and a superadmin. The `||` short-
       * circuits, so reading your own profile never pays for the extra lookup.
       */
      allow read: if isAuth() && (
        request.auth.uid == userId
        || sharesAClinicWithCaller()
        || isSuperAdmin()
      );

      // First-login self-provisioning (see AuthContext). Never allowed to self-grant
      // isSuperAdmin or pre-seed clinicRoles at creation time.
      allow create: if isAuth() && request.auth.uid == userId
        && request.resource.data.get('isSuperAdmin', false) == false
        && request.resource.data.get('clinicRoles', {}) == {}
        && request.resource.data.get('clinicPermissions', {}) == {};

      // Users may edit their own profile fields, but never isSuperAdmin, clinicRoles or
      // clinicPermissions. All three are granted server-side via the Admin SDK (staff invite /
      // self-signup / role change routes). clinicPermissions has to be on this list or the whole
      // permission system is self-service: the rules below read that field to decide what someone
      // may write, so a member who could edit it would simply grant themselves the delete rights
      // their admin withheld — and, worse, could clear it entirely and land back on the
      // no-record-yet fallback that allows everything.
      allow update: if isSuperAdmin()
        || (isAuth() && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['isSuperAdmin', 'clinicRoles', 'clinicPermissions']));

      allow delete: if isSuperAdmin();
    }

    match /join_requests/{requestId} {
      // Each request carries a name and an email. `if isAuth()` made every request anyone had
      // ever filed, for any clinic, readable by every account on the platform. Only the person
      // who sent it and an admin of the clinic it was sent to have any reason to see it.
      allow read: if isSuperAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid)
        || (isAuth() && isClinicAdmin(resource.data.clinicId));

      // Filed through /api/join-requests/create on the Admin SDK, not from the browser.
      // A client write cannot check that the Clinic ID is real — rules deny reading a clinic
      // you hold no role in, which is the very situation this request exists to resolve — so a
      // typo used to be accepted silently and waited on forever. The server also derives the
      // stored name and email from the caller's Auth record instead of the request body, and
      // keys the document on (user, clinic) so pressing the button twice cannot spam the
      // admin's review screen.
      allow create: if false;
      // Only Clinic Admins of the requested clinic (or Super Admins) can approve/reject,
      // and approving may only ever change the `status` field.
      allow update: if isSuperAdmin()
        || (isAuth() && isClinicAdmin(resource.data.clinicId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isSuperAdmin() || (isAuth() && isClinicAdmin(resource.data.clinicId));
    }

    // =====================================================================
    // --- CLINICS MULTI-TENANCY ---
    // =====================================================================

    match /clinics/{clinicId} {
      allow read: if isSuperAdmin() || hasClinicRole(clinicId);
      // Tier/status/pricing/features are superadmin-only. Self-signup creates clinics
      // server-side via Admin SDK (/api/onboarding/create-clinic), which bypasses rules.
      // Clinic self-service profile edits live in settings/clinicProfile below.
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // --- ALL CLINIC SUBCOLLECTIONS ---
      // Any role in the clinic can read/write subcollections; writes also require an active clinic.
      // IMPORTANT: keep the {subcollection} segment. A bare /{document=**} here would also match
      // the parent clinic doc (wildcards can match zero segments), and since rules OR together it
      // would silently undo the superadmin-only restriction above.
      //
      // system_logs, staff, and settings are carved out of the general write grant here because
      // Firestore rules OR together: a narrower `allow write` in a more specific match block below
      // can only ever add permissions, never take away what this block already granted. Without
      // excluding them here, the "Admin only" restrictions on staff/settings and the "superadmin
      // only can edit/delete" restriction on system_logs below would all be silently overridden by
      // "any clinic member can write" up here. staff/settings had this exact bug live in production
      // — the override blocks looked like they restricted access but never actually did anything.
      //
      // Split into create/update/delete rather than one `write`, because that is the grain the
      // permission checkboxes are written at: "add patients" and "delete patients" are separate
      // decisions, and a single `write` rule cannot tell the two apart. Reads are deliberately
      // NOT gated on permissions — inside one clinic, the staff are the people trusted with that
      // clinic's records, and the boundary that matters (one clinic never seeing another's) is
      // enforced above. Gating reads would also break the app in a hundred quiet places, since
      // the appointments screen reads patients, the ledger reads patients, and so on.
      match /{subcollection}/{document=**} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create: if isSuperAdmin()
          || (memberMayWrite(clinicId, subcollection) && holdsPermission(clinicId, permCreate(subcollection)));
        allow update: if isSuperAdmin()
          || (memberMayWrite(clinicId, subcollection) && holdsPermission(clinicId, permUpdate(subcollection)));
        allow delete: if isSuperAdmin()
          || (memberMayWrite(clinicId, subcollection) && holdsPermission(clinicId, permDelete(subcollection)));
      }

      // --- SPECIFIC SUBCOLLECTION OVERRIDES ---
      // If you need more granular permissions (e.g. only Admins can delete staff)
      match /staff/{staffId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if isSuperAdmin() || (isClinicAdmin(clinicId) && isClinicActive(clinicId));

        /**
         * Your own row, your own details.
         *
         * Everything about a staff record is an Admin decision except the part that describes the
         * person: their photo, how they want to be called, their own phone number. Admin-only on
         * the whole document meant nobody below Admin could set a profile picture — the Profile
         * screen simply failed. `hasOnly` is what keeps this safe: `role`, `permissions`,
         * `commissionPercentage`, `isDentist` and `uid` are all absent from the list, so this can
         * never become a way to promote yourself or award yourself a commission.
         */
        allow update: if isAuth() && hasClinicRole(clinicId) && isClinicActive(clinicId)
          && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'nickname', 'phone', 'bio', 'photoURL', 'updatedAt']);

        /**
         * Claiming a staff row that was created before the person had a login.
         *
         * The attendance screen links the two the first time someone checks in, by writing their
         * uid onto the row that carries their email. Only an unclaimed row (no uid yet) whose
         * email matches the signed-in account, and `uid` is the only field the write may touch —
         * so this cannot be used to take over a colleague's record.
         */
        allow update: if isAuth() && hasClinicRole(clinicId) && isClinicActive(clinicId)
          && resource.data.get('uid', '') == ''
          && resource.data.get('email', '') == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
      }

      match /settings/{docId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if isSuperAdmin() || (isClinicAdmin(clinicId) && isClinicActive(clinicId));
      }

      /**
       * The file-ID counter — `PT-1000`, `PT-1001`, and so on.
       *
       * It lives under `settings` for historical reasons, but it is not a setting: every patient
       * created bumps it, inside the transaction that mints their file number. `settings` is
       * Admin-only, so that transaction was denied for everybody else — which is why a
       * receptionist with "Add patients" switched on still got "Error adding patient". The
       * patient row was never even attempted; the write that failed was this counter. The same
       * transaction runs when reception books a first appointment for a new patient, and when a
       * lead is converted, so all three were blocked by one rule.
       *
       * Rules OR together, so this widens access for this ONE document while every other
       * settings document stays Admin-only. Gated on `patients.add`, the same permission as
       * creating the patient it numbers — nobody gains the ability to bump it who could not
       * already create the record that consumes it.
       */
      match /settings/counters {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId)
              && holdsPermission(clinicId, 'patients.add'));
      }

      // Audit trail: append-only. Any clinic member can read the log and add an entry (that's
      // what every action in the app does via logActivity()), but nothing in the app ever
      // updates or deletes a log entry — not even a Clinic Admin can rewrite or erase history.
      // That's what makes it worth trusting as a record of what actually happened.
      // Everyone who asked but never booked. Reception adds and works leads all day, so
      // creating and updating stays open to any member — but deleting is Admin-only, because
      // the marketing report is only as honest as its history. A lost lead with an awkward
      // reason is exactly the record most worth keeping, and "lost" already hides it from
      // the working list without erasing it. Note this subcollection is excluded from the
      // blanket member-write grant above; without that exclusion the two rules would OR
      // together and this restriction would do nothing at all.
      match /leads/{leadId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin() || (hasClinicRole(clinicId) && isClinicActive(clinicId));
        // Deleting goes through /api/records/delete, which still requires an Admin and snapshots
        // the lead first — a lost lead with an awkward reason is the record most worth keeping.
        allow delete: if false;
      }


      // --- COLLECTIONS THE RECYCLE BIN OWNS -------------------------------------------------
      //
      // Each of these keeps exactly the access it had, with one change: the client may no longer
      // DELETE. Deletion goes through /api/records/delete, which photographs the record into the
      // root `deleted_records` collection first, so a mistake is recoverable from Settings →
      // Recently Deleted instead of being final.
      //
      // Creates and updates still name their permission, because those are unchanged decisions.
      // The names above are held out of the blanket member-write grant; without that these blocks
      // would be ORed with it and change nothing at all.
      //
      // `services` and `leads` were already Admin-only and keep their own blocks further down;
      // they are binned too, but their rules did not need to move.

      match /patients/{patientId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'patients.add'));
        allow update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'patients.edit'));
        allow delete: if false;
      }

      match /patient_media/{mediaId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'patients.edit'));
        allow delete: if false;
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'clinical.edit'));
        allow delete: if false;
      }

      match /treatment_plans/{planId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'clinical.edit'));
        allow delete: if false;
      }

      match /diagnosis_chats/{chatId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'clinical.edit'));
        allow delete: if false;
      }

      match /inventory/{itemId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'inventory.add'));
        allow update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'inventory.edit'));
        allow delete: if false;
      }

      match /drugs/{drugId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'access.settings'));
        allow delete: if false;
      }

      match /marketing_content/{contentId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId) && holdsPermission(clinicId, 'access.marketing'));
        allow delete: if false;
      }

      // Attendance rows are written by the staff member clocking in, so creates and updates stay
      // open to any active member; only removing a log — which moves payroll — is restricted.
      match /attendance/{logId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin() || (hasClinicRole(clinicId) && isClinicActive(clinicId));
        allow delete: if false;
      }

      // Money. Every write goes through /api/finance/ledger or /api/clinical/procedures on the
      // Admin SDK, and the client is denied outright here.
      //
      // This is what makes the finance.* permissions mean anything. They were checked only in the
      // browser, where they decide whether a button renders — while this collection was writable
      // by every member of the clinic through the SDK regardless. A receptionist with no finance
      // permission at all could rewrite any charge, any payment, any commission.
      //
      // It is also what makes the arithmetic hold. The routes decide inside a transaction which
      // payment carries the lab fee, resolve the treating dentist from the procedure, and refuse
      // to delete a charge that has money against it. None of that can be enforced from a browser
      // that is free to write whatever it likes.
      //
      // Note this subcollection is excluded from the blanket member-write grant above; without
      // that exclusion the two rules would OR together and this deny would do nothing at all.
      match /ledger/{rowId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      // Before/after snapshots of every money change: who altered a charge, and what it held
      // beforehand. Server-written only — an audit trail the audited party can edit is not an
      // audit trail. Staff can read it.
      match /ledger_audit/{entryId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      // Clinical records. A note and its charge are written together in one transaction, and the
      // note carries the cost the patient is billed — so the same reasoning as `ledger` applies.
      //
      // The single exception is `sortIndex`: dragging the treatment timeline into order is a
      // display arrangement the whole clinic shares (see Note.sortIndex), it moves no money, and
      // routing a drag through an API would make it feel broken. `hasOnly` is what keeps that
      // narrow — a drag cannot smuggle a changed `cost` along with the new position.
      match /clinical_notes/{noteId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sortIndex']));
        allow create, delete: if false;
      }

      // The price list. Admin-only to write: it is the instrument that decides what every
      // treatment costs, and the server prices procedures from it rather than from the browser,
      // so a member who could edit it could set any price they liked. Settings is already an
      // admin-only area; this makes the data agree with the screen.
      match /services/{serviceId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin() || (isClinicAdmin(clinicId) && isClinicActive(clinicId));
        // Still Admin-only, now through /api/records/delete so a removed price is recoverable.
        allow delete: if false;
      }

      match /system_logs/{logId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create: if isSuperAdmin() || (hasClinicRole(clinicId) && isClinicActive(clinicId));
        allow update, delete: if isSuperAdmin();
      }

      // Pre-delete snapshots taken when the assistant deletes a record. Written only by the
      // Gemini route via the Admin SDK, which bypasses rules — so no client ever needs write
      // access here, and denying it outright is what makes this a record of AI deletions that
      // the person who triggered them cannot then erase. Staff can still read it to review.
      match /ai_deletion_log/{entryId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      // Destructive assistant actions awaiting the user's confirmation. Both staging and
      // approval go through API routes on the Admin SDK, so the client never needs to write
      // here — and must not, since editing a staged action's target between being shown the
      // prompt and approving it would make the confirmation meaningless.
      match /ai_pending_actions/{actionId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      // The AI credit meter and its per-event usage log. Every charge is written by an API
      // route on the Admin SDK; no client ever needs write access — and must not have it,
      // because a member who can edit the counter can quietly refill their clinic's own
      // credits, and a member who can edit the log can erase what the refill was spent on.
      // Note both are excluded from the blanket member-write grant above; rules OR together,
      // so without that exclusion these denies would do nothing at all.
      match /ai_usage/{monthKey} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      match /ai_usage_log/{entryId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      // Outbound messages drafted automatically and held for review. Staff read the queue here,
      // but approving goes through /api/message-drafts on the Admin SDK — if the client could
      // write, someone could change a draft's recipient or body after it was reviewed, or flip a
      // status to 'sent' without anything actually being sent.
      match /message_drafts/{draftId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow write: if false;
      }

      // Text messages waiting for the clinic's own phone to send them.
      //
      // Creating one stays server-only: the nightly job composes the message, and a client that
      // could create rows here could text any number in the clinic's name.
      //
      // Updating is allowed, narrowly, because the sender is now the clinic's phone signed in as
      // itself rather than an API caller — it has to be able to claim a message and report what
      // happened. The `hasOnly` list is what keeps that safe: `to` and `text` are not in it, so a
      // queued message can never be redirected to another number or have its wording changed after
      // it was composed. The worst a clinic member can do is lie about the outcome of a message
      // that was genuinely queued for that clinic.
      //
      // Deleting stays closed so the record of what was sent cannot be quietly erased.
      match /sms_outbox/{messageId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'sentAt', 'error', 'attempts', 'claimedAt', 'claimedByDeviceId']));
        allow create, delete: if false;
      }

      // WhatsApp messages waiting for a person at the clinic to press send.
      //
      // Same shape of protection as sms_outbox and for the same reason: the server composes the
      // message, and a client able to create rows here could put words in the clinic's mouth to
      // any number it liked. `to` and `text` are absent from the update list, so a message cannot
      // be redirected or reworded between being composed and being sent.
      //
      // The difference from sms_outbox is that nothing claims a message here — a human is holding
      // the phone, so there is no background worker to race. Marking one sent is the only change a
      // client makes.
      match /whatsapp_outbox/{messageId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow update: if isSuperAdmin()
          || (hasClinicRole(clinicId) && isClinicActive(clinicId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'sentAt', 'sentByDeviceId']));
        allow create, delete: if false;
      }

      // Phones offering to send this clinic's reminders. The app writes a heartbeat here every
      // time its background job wakes up, and the nightly job refuses to queue anything unless one
      // of these was seen recently. Clinic members may write because the phone IS a clinic member
      // — a forged entry only causes messages to queue with nobody collecting them, which the
      // settings screen shows plainly, and grants no ability to send or read anything.
      //
      // Deleting is the exception, and it is closed. revokeDevice() in lib/sms/devices disables a
      // phone rather than removing it, deliberately: which phone sent this clinic's messages, and
      // until when, is worth keeping. A delete also stops the clinic's reminders outright, because
      // hasActiveDevice() queues nothing once the last live heartbeat is gone — a quiet failure
      // any member could cause. Note this subcollection is excluded from the blanket member-write
      // grant above; without that exclusion the two rules would OR together and this deny would
      // do nothing at all.
      match /sms_devices/{deviceId} {
        allow read: if isSuperAdmin() || hasClinicRole(clinicId);
        allow create, update: if isSuperAdmin() || (hasClinicRole(clinicId) && isClinicActive(clinicId));
        allow delete: if false;
      }
    }
    

    // --- THE RECYCLE BIN ---
    //
    // Root collections, not `clinics/{clinicId}/deleted_records`, and the reason is the blanket
    // grant above: every clinic subcollection is readable by every clinic member, and rules OR
    // together, so a narrower block underneath cannot take that back. A bin under the clinic would
    // therefore be readable by the whole clinic by construction — and its entries are complete
    // patient records: allergies, medical history, the odontogram, image URLs. The narrower rule
    // would have looked like protection and provided none.
    //
    // Denied to every client outright. /api/records/bin serves the list, filtered to what the
    // caller is allowed to see; /api/records/restore and /api/records/purge are the only writers.
    // A member-writable bin entry would also be an arbitrary-write capability into any collection,
    // because restore executes whatever the entry names using the Admin SDK.
    match /deleted_records/{entryId} {
      allow read, write: if false;
    }

    match /deleted_records/{entryId}/{document=**} {
      allow read, write: if false;
    }

    // The permanent record that a deletion happened, carrying no snapshot. Retention removes
    // copies of data; it must never remove the fact.
    match /deleted_records_history/{entryId} {
      allow read, write: if false;
    }

    // Storage object paths whose last naming document was purged, kept so the files stay findable.
    match /storage_orphans/{entryId} {
      allow read, write: if false;
    }

    // --- PER-CLINIC SECRETS ---
    // WhatsApp access tokens and any future third-party credentials live here, NOT under
    // clinics/{clinicId}/. That subtree is covered by `match /{subcollection}/{document=**}`
    // above, which grants read to every member of the clinic — so a receptionist could read a
    // token that sends WhatsApp messages as the clinic. Rules OR together, so a narrower deny
    // inside that subtree cannot take the access back; a separate top-level collection can.
    // Server-only: written and read exclusively via the Admin SDK, which bypasses rules.
    match /clinic_secrets/{clinicId} {
      allow read, write: if false;
    }

    // --- META LEAD ADS INTEGRATION ---
    // App credentials (verify token, app secret) and the Facebook-page → clinic mapping with
    // its page access tokens. Top-level for the same reason as clinic_secrets: the clinic
    // wildcard grant must never reach them. Only the metaLeadsWebhook function and the
    // connect-meta-page script touch these, both via the Admin SDK.
    match /meta_integrations/{docId} {
      allow read, write: if false;
    }

    match /meta_pages/{pageId} {
      allow read, write: if false;
    }

    // The lead replay queue: one doc per lead Meta has announced, holding delivery state
    // until it lands. Written only by the webhook and its retry sweep, both Admin SDK.
    match /meta_lead_events/{leadgenId} {
      allow read, write: if false;
    }

    // --- RETIRED: root SMS pairing (2026-08-14) ---
    // The old WebView app had no login of its own, so it authenticated to an API with a device
    // token obtained by pairing code, and both lived here at the root — out of reach of the
    // blanket clinic-member read grant. The native app signs in as a real staff user and reads the
    // queue straight from Firestore, so neither exists any more. Denied explicitly rather than
    // deleted, so that a stale client still holding a token gets nothing.
    match /sms_devices/{deviceId} {
      allow read, write: if false;
    }

    match /sms_pairing_codes/{code} {
      allow read, write: if false;
    }
  }
}
