rules_version = '2';

// Cloud Storage rules.
//
// This file did not exist until 2026-08-24, and until 2026-08-27 it had still never been deployed.
// What actually governed the bucket was the Firebase console's starter template:
//
//     allow read, write: if request.time < timestamp.date(2026, 8, 27);
//
// Unauthenticated read and write over the whole bucket, with an expiry date on it. On 2026-08-27
// the date passed, every upload in the app started failing with "Upload failed", and that is how
// anyone found out this file was a document rather than a deployed ruleset.
//
// --- why there is no membership check here -------------------------------------------------------
//
// The first version of this file asked Firestore who the uploader was:
//
//     firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
//
// That can never work in this project. Storage rules may only reach the `(default)` Firestore
// database — Google's own limit, stated as a warning on the Storage rules-conditions page — and
// this project's database is literally NAMED `default`, which is a different database. `(default)`
// does not exist here at all; see the comment in firebase.json, where the CLI tried to create it.
//
// So the lookup would find nothing, the membership check would be false for every user, and
// deploying that version would have swapped "everything is allowed" for "nothing is allowed". The
// upload would still fail, just for the opposite reason.
//
// What the clinic rule below can therefore check is that you are signed in. It cannot check WHICH
// clinic you belong to. Stated plainly, that costs: a signed-in user who knows another clinic's id
// could read a file at a path they already know, or write a file into that clinic's folder. Two
// things bound it — clinic ids are Firestore auto-ids (`SmtW6r6jKaFhfRWYcxsG`), so they are not
// guessable, and `list` is granted nowhere below, so the bucket cannot be enumerated to find one.
//
// Closing that properly needs the uploader's clinics inside the auth token (custom claims, kept in
// step with users/{uid}.clinicRoles) or uploads moved behind a server-issued signed URL. Both are
// real work; neither belongs in the change that stops the bucket being world-writable.
//
// --- two things that make these rules shorter than they look -------------------------------------
//
// 1. The app never reads Storage by path. It uploads, calls getDownloadURL(), and stores that URL
//    in Firestore; every <img> renders from the stored URL. A download URL carries its own token
//    and does not consult these rules at all — which is why the public booking page keeps working
//    with no unauthenticated grant anywhere below. `getDownloadURL` DOES consult them, which is
//    why `get` is granted: that call happens moments after the upload, while still signed in.
//
// 2. Nothing lists and nothing deletes from the browser. There is no listAll() and no
//    deleteObject() anywhere in src/, so neither is granted. Server-side cleanup is unaffected —
//    the recycle bin deletes through the Admin SDK, which ignores rules entirely.

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    // 20 MB. Large enough for a full-resolution intraoral photograph, small enough that a mistake
    // or a malicious upload cannot quietly fill the bucket.
    function sizeOk() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // Guarded against a null contentType. An unset one makes `.matches()` error, and a rule that
    // errors denies — which the user would read as "Upload failed" all over again.
    function isImage() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('image/.*');
    }

    // --- everything a clinic owns -----------------------------------------------------------
    //
    // One rule covers patient avatars, patient media, tooth photographs, the logo and the booking
    // hero, because src/lib/storagePaths.ts puts all of them under the clinic. The clinic segment
    // no longer changes the decision (see above), but it stays named so the day custom claims or
    // signed URLs land, the check has somewhere to go.
    //
    // `get` rather than `read`: in rules_version 2, `read` is `get` + `list`, and granting list
    // would let any signed-in user enumerate a clinic's patient photographs. Only `get` is needed.
    //
    // `create, update` rather than `write`: `write` is create + update + delete. No browser code
    // deletes from Storage, so refusing delete costs nothing and means no signed-in user can erase
    // a clinic's files.
    //
    // No content-type check: this folder legitimately holds uploaded documents, not just images.
    match /clinics/{clinicId}/{allPaths=**} {
      allow get: if isAuth();
      allow create, update: if isAuth() && sizeOk();
    }

    // --- a person's own profile picture -----------------------------------------------------
    //
    // Not under a clinic, on purpose: one person can work at several and the picture is theirs.
    // The uid prefix is what makes it enforceable — you may write only a file named for you. This
    // is the one prefix where the rule is still fully enforced, because the identity it needs is
    // in the path and in the token, with no Firestore lookup in between.
    match /staff_profiles/{fileName} {
      allow get: if isAuth();
      allow create, update: if isAuth()
        && fileName.split('_')[0] == request.auth.uid
        && sizeOk() && isImage();
    }

    // --- the legacy prefixes ----------------------------------------------------------------
    //
    // Files uploaded before the paths carried a clinic. They are frozen, not deleted: the URLs
    // already stored in Firestore keep working, because a download URL's token bypasses rules.
    // What is refused here is path access — reading a known object through the SDK, and above all
    // listing, which on `clinical_notes/` would have handed any signed-in user every clinic's
    // intraoral photographs.
    //
    // A rule cannot do better than this for these prefixes. `clinical_notes/tooth_11_1724.jpg`
    // does not say which clinic it belongs to, and there is no way to find out from the path, so
    // the only choices are deny-all and allow-any-signed-in-user. Deny-all is correct, and it is
    // only survivable because nothing in the app reads these by path.
    //
    // Server-side cleanup is unaffected — the Admin SDK ignores rules entirely, which is how the
    // recycle bin deletes the objects behind a deleted record.
    match /patients/{allPaths=**}       { allow read, write: if false; }
    match /clinical_notes/{allPaths=**} { allow read, write: if false; }
    match /clinicProfile/{allPaths=**}  { allow read, write: if false; }

    // Anything not named above. Storage has no implicit deny worth relying on across rule
    // versions, so it is stated.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
