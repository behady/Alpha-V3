# Build output
build/
.gradle/
*.apk

# Machine-specific SDK location
local.properties

# Firebase identifiers for this project. Not secret in the security sense — a
# Firestore API key is an identifier, and the actual protection is the security
# rules — but there is no reason to publish the project's ids in the repo.
firebase.properties
# Same project ids in Google's own layout. Needed by the Crashlytics Gradle plugin to upload
# the release mapping file. Holds BOTH Android apps (release package and .debug package);
# see README.md - "If google-services.json goes missing".
app/google-services.json

# Signing. Whoever holds these can publish an app that pretends to be yours.
*.jks
keystore.properties
